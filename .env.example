# ============================================
# CodeArena Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://codearena:codearena_dev@localhost:5432/codearena?schema=public"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Authentication ────────────────────────────
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_64_CHARS"
JWT_EXPIRATION="7d"
JWT_REFRESH_EXPIRATION="30d"
BCRYPT_SALT_ROUNDS="12"

# ── Application ───────────────────────────────
NODE_ENV="development"
API_PORT="4000"
WEB_PORT="3000"
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
INTERNAL_API_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"
ADMIN_SECRET_KEY="CHANGE_ME_TO_A_32_CHAR_HMAC_SECRET"

# ── Email Provider Configuration (Phase 1 Security) ──
# Option 1: Direct Gmail SMTP (Recommended for rapid setup)
GMAIL_USER="your-organization@gmail.com"
GMAIL_APP_PASSWORD="16-character-google-app-password"

# Option 2: Standard SMTP / Enterprise Provider (SendGrid, Brevo, AWS SES, Mailgun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CodeArena <noreply@codearena.dev>"

# ── AI Mentor (Provider Abstraction) ──────────
# Supported: mock | openai | anthropic
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gpt-4"

# ── Code Execution ───────────────────────────
CODE_EXECUTION_URL="http://localhost:4001"
CODE_EXECUTION_TIMEOUT_MS="10000"
CODE_EXECUTION_MEMORY_LIMIT_MB="256"
CODE_EXECUTION_CPU_LIMIT="1"

# ── Admin Seed ────────────────────────────────
ADMIN_EMAIL="admin@codearena.dev"
ADMIN_PASSWORD="CHANGE_ME_admin_password_123!"

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# ── Session ───────────────────────────────────
COOKIE_SECRET="CHANGE_ME_TO_ANOTHER_SECURE_RANDOM_STRING"
COOKIE_DOMAIN="localhost"
